# Local-dev environment. Copy to .env and fill in. Never commit .env.
# In staging/prod these values come from Vault / SOPS.

AUTO_AFFI__ENV=dev

# Vendor API keys — leave blank locally if you are not exercising that adapter.
AUTO_AFFI__ANTHROPIC_API_KEY=
AUTO_AFFI__KIE_API_KEY=
AUTO_AFFI__ELEVENLABS_API_KEY=
AUTO_AFFI__SHOPEE_APP_ID=
AUTO_AFFI__SHOPEE_SECRET=

# Data plane
AUTO_AFFI__POSTGRES_DSN=postgresql+asyncpg://localhost:5432/auto_affi
AUTO_AFFI__REDIS_URL=redis://localhost:6379/0
AUTO_AFFI__S3_BUCKET=auto-affi-dev

# Budgets
AUTO_AFFI__DAILY_OPUS_BUDGET_USD=50.0
AUTO_AFFI__PER_VIDEO_BUDGET_USD=3.32
